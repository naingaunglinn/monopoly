{
  "name": "global-monopoly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Global Monopoly: a pass-the-device property board game for 2 to 6 players.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "tsx src/sim/cli.ts",
    "typecheck": "tsc --noEmit",
    "dev:online": "node scripts/dev-online.mjs",
    "serve:online": "tsx server/local.ts --port 4175 --static dist",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@upstash/redis": "^1.39.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
